# === 비밀값: 절대 커밋하지 않는다 ===
# 금고 열쇠는 각 PC 서랍에만. 저장소에는 "열쇠 모양"(.env.example)만
.env
.env.*
!.env.example

# === Elixir · Phoenix (phx.new 1.8.17 템플릿 그대로) ===
# mix가 컴파일 결과를 쓰는 곳 (Go의 bin/, Rust의 target/ 같은 자리)
/_build/
# mix test --cover 결과
/cover/
# 의존성 소스를 받아 두는 곳. mix.lock만 있으면 mix deps.get으로 다시 생긴다
/deps/
# ExDoc 같은 도구가 만든 문서
/doc/
/.fetch
# BEAM이 죽으면 남기는 덤프
erl_crash.dump
*.ez
/tmp/
itinerail-*.tar

# 빌드 도구(esbuild · tailwind)가 만든 결과물. 원본은 assets/에 있다
/priv/static/assets/
/priv/static/cache_manifest.json

# npm 들이는 날(M4)부터 생긴다
npm-debug.log
/assets/node_modules/

# === 편집기 도구 캐시 ===
# ElixirLS가 프로젝트 안에 만드는 분석 캐시
/.elixir_ls/
# Task가 "바뀌었나" 판단용으로 남기는 체크섬
/.task/

# === 에디터 · OS ===
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Claude Code 작업 폴더 (세션 worktree 등)
.claude/
